# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Hevy login (used by extraction/scrape_export.py)
HEVY_EMAIL=
HEVY_PASSWORD=

# AWS (used by extraction/upload_s3.py and Airflow's S3/Snowflake tasks)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Snowflake (used by dbt profiles.yml; the Airflow side additionally needs
# a snowflake_default Connection set up via the Airflow UI -- see README)
# Auth is RSA key-pair, not a password: HEVY_PIPELINE_SVC is a TYPE=SERVICE
# user with no password, created because the personal login has MFA
# enabled (blocks unattended weekly automation).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=hevy_wh
SNOWFLAKE_DATABASE=hevy
SNOWFLAKE_ROLE=
