# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Hevy login (used by extraction/scrape_export.py)
HEVY_EMAIL=
HEVY_PASSWORD=

# AWS (used by extraction/upload_s3.py and Airflow's S3/Snowflake tasks)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Snowflake (used by dbt profiles.yml and Airflow's Snowflake tasks)
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=hevy_wh
SNOWFLAKE_DATABASE=hevy
SNOWFLAKE_ROLE=
